<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tetra_bringup</name>
  <version>1.3.4</version>
  <description>Bringup scripts and configurations for the Nav2 stack</description>
  <maintainer email="wbjin@hyulimrobot.com">Wookbin Jin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>nav2_common</build_depend>

  <build_depend>navigation2</build_depend>
  <build_depend>launch_ros</build_depend>

  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>xacro</exec_depend>

  <depend>rosbridge_server</depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_testing</test_depend>

  <exec_depend>tetra</exec_depend>
  <exec_depend>tetra_description</exec_depend>
  <exec_depend>tetra_interface</exec_depend>
  <exec_depend>iahrs_driver</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>cyglidar_d1_ros2</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>virtual_wall</exec_depend>
  <exec_depend>tetra_service</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
